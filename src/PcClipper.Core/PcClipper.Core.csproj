<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral engine: no Windows APIs here, so it can be tested on Linux with real ffmpeg. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PcClipper.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure managed (netstandard2.0): only its WdlResampler is used, for audio clock-drift correction. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
</Project>
